# Copy to .env locally. In Vercel, set the project Root Directory to backend/
# and add these values in Project Settings > Environment Variables.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Use Supabase's Transaction Pooler (port 6543), not its direct connection.
# Example format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.<project-ref>:your-password@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=["gemini-3.8-flash","gemini-3.6-flash"]
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# Comma-separated public frontend origin(s), without a trailing slash.
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app
